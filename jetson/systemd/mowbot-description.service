[Unit]
Description=mowbot robot_state_publisher (modele URDF + TF roues)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nvidia
Environment=HOME=/home/nvidia
ExecStartPre=/bin/sleep 8
ExecStart=/bin/bash /home/nvidia/run_description.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
