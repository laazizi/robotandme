[Unit]
Description=mowbot rosbridge (WebSocket 9090 pour app mobile)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nvidia
Environment=HOME=/home/nvidia
ExecStartPre=/bin/sleep 8
ExecStart=/bin/bash /home/nvidia/run_rosbridge.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
