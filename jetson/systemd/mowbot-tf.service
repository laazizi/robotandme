[Unit]
Description=mowbot TF statiques (laser_link, imu_link)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nvidia
Environment=HOME=/home/nvidia
ExecStartPre=/bin/sleep 6
ExecStart=/bin/bash /home/nvidia/run_tf.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
