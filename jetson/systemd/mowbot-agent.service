[Unit]
Description=mowbot micro-ROS agent (controle robot)
# Demarrer APRES le reseau (sinon le participant DDS se lie avant que le WiFi
# soit up -> topics invisibles depuis le PC). sleep 8 = marge WiFi/DHCP.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nvidia
Environment=HOME=/home/nvidia
ExecStartPre=/bin/sleep 8
ExecStart=/bin/bash /home/nvidia/robot_start.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
