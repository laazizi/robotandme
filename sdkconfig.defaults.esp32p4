# Specifique ESP32-P4 (Waveshare ESP32-P4-ETH) — ajoute automatiquement par
# IDF quand la cible est esp32p4.

# Revision de puce : la carte embarque un ESP32-P4 v1.3 (echantillon
# pre-serie). IDF v5.5 cible par defaut les puces >=v3.1 (production) et
# refuse de flasher v1.x. On active le support des revisions <3.0 et on fixe
# le minimum a v1.0. ATTENTION : un binaire compile ainsi ne tournera PAS sur
# une puce v3.x — a rebasculer (ou retirer ces lignes) si passage en silicium
# de production.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# ESP Hosted (WiFi sur SPI vers ESP32-C6) : desactive car on n'utilise pas le
# WiFi (transport serie ou Ethernet). Evite un crash au boot sur IDF v5.5.
CONFIG_ESP_HOSTED_ENABLED=n
