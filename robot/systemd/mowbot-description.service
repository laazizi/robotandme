[Unit]
Description=mowbot modele URDF (robot_state_publisher)
# __USER__ / __HOME__ sont remplaces par install.sh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Environment=HOME=__HOME__
ExecStartPre=/bin/sleep 8
ExecStart=/bin/bash __HOME__/mowbot/bin/run_description.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
