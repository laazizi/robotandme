<?xml version="1.0"?>
<!-- mowbot — modele fidele au chassis actuel (photos) :
     - plateau de base ROND en BOIS clair (~Ø44 cm)
     - 2 roues motrices Ø15 cm, pneus BLANCS + jantes noires
     - ROUE DIRECTRICE a l'AVANT, commandee par un servo RC (elle remplace la
       roulette folle). Contact a x = +0.36, c'est STEER_X_M de
       controllers/ackerbot_p4/main/robot.h.
       SENS DE MARCHE INVERSE LE 04/09/2026 : l'avant du robot est le cote de
       la roue directrice, sur indication de l'utilisateur ("le robot roule en
       arriere et non en direction du servo"). Tout le modele a donc ete mis en
       MIROIR (x et y), le lidar est passe de -0.16 a +0.16, et les etiquettes
       avant/arriere et gauche/droite ont ete reassignees d'apres les positions
       obtenues — sans quoi on recreait la confusion qui a coute des heures.
       Le robot est desormais un TRICYCLE CLASSIQUE : roue directrice qui MENE,
       deux roues motrices derriere, lidar en tete du sens de marche.
     - 4 montants en bois soutenant un plateau ALU en etage (~27 cm)
     - LIDAR (noir) sur le plateau alu, 10 cm en ARRIERE du centre, 28 cm de
       haut (16 cm mesures au metre). DOIT correspondre a MOWBOT_LIDAR_X de
       bin/run_tf.sh : l'autre robot du projet l'a a +0.10, celui-ci a -0.16.
     - batterie bleue + electronique (MDD10A, DevKitC) sur la base
     base_link : centre du robot, a hauteur d'axe des roues.
     x = AVANT = cote de la ROUE DIRECTRICE et du LIDAR (tous deux a x > 0
     depuis l'inversion du 04/09/2026). front_marker (+0.205) le repere en
     rouge et n'a PAS ete mis en miroir : c'est un repere d'affichage, il doit
     rester a l'avant. -->
<robot name="mowbot">

  <material name="bois">      <color rgba="0.85 0.72 0.50 1.0"/></material>
  <material name="alu">       <color rgba="0.75 0.76 0.78 1.0"/></material>
  <material name="pneu_blanc"><color rgba="0.93 0.93 0.90 1.0"/></material>
  <material name="noir">      <color rgba="0.11 0.11 0.12 1.0"/></material>
  <material name="bleu_batt"> <color rgba="0.13 0.34 0.75 1.0"/></material>
  <material name="vert_pcb">  <color rgba="0.10 0.45 0.20 1.0"/></material>
  <material name="rouge">     <color rgba="0.85 0.15 0.10 1.0"/></material>

  <!-- ===== Plateau de base : disque de bois ===== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <!-- rayon 0.2429 = bord exterieur des roues DESSINEES (0.22035 +
           demi-largeur de roue 0.0225). L'ancienne valeur 0.22
           faisait DEPASSER les roues du plateau a l'affichage, ce qui laissait
           croire a une erreur de geometrie alors que les positions de roues
           etaient justes.
           CE RAYON N'A PAS ETE MESURE sur le robot : il est aligne sur
           l'enveloppe des roues pour que le dessin soit coherent. Si le plateau
           reel est plus grand ou plus petit, corriger ici : ca n'a AUCUN effet
           sur la navigation, qui utilise le footprint de nav2_params.yaml. -->
      <geometry><cylinder radius="0.2429" length="0.018"/></geometry>
      <material name="bois"/>
    </visual>
  </link>

  <!-- Petite languette ARRIERE en bois (celle qui porte la roulette folle) :
       deborde de ~5 cm du disque, sur ~15 cm de large seulement. C'est le seul
       endroit ou le robot n'est pas un disque -> le footprint nav2 la reprend
       telle quelle plutot que d'elargir tout l'arriere. -->
  <link name="steer_arm">
    <visual>
      <geometry><box size="0.16 0.15 0.018"/></geometry>
      <material name="bois"/>
    </visual>
  </link>
  <!-- Bras de direction : il porte la roue directrice a +0.36, alors que le
       plateau rond s'arrete vers +0.22. Longueur et position DEDUITES de ces
       deux extremites, pas mesurees : seul le point de contact de la roue
       l'est. A corriger si le bras reel differe. -->
  <joint name="base_to_steer_arm" type="fixed">
    <parent link="base_link"/><child link="steer_arm"/>
    <origin xyz="0.29 0 -0.02"/>
  </joint>

  <!-- ===== Roues motrices (pneus blancs) ===== -->
  <link name="wheel_left">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.075" length="0.045"/></geometry>
      <material name="pneu_blanc"/>
    </visual>
  </link>
  <joint name="base_to_wheel_left" type="fixed">
    <parent link="base_link"/><child link="wheel_left"/>
    <!-- 0.22035 : position des roues A L'AFFICHAGE, rentree de 1 cm par
         rapport au demi entraxe cinematique.
         POURQUOI L'ECART. L'entraxe calibre au sol vaut 0.4607 m, soit un demi
         entraxe de 0.23035 : c'est la distance entre les POINTS DE CONTACT, et
         c'est cette valeur qui gouverne la cinematique (TRACK_WIDTH_M dans le
         firmware). Mais le cylindre dessine fait 4.5 cm de large, donc son bord
         exterieur atteignait 0.2529 : a l'ecran la roue TOUCHAIT un obstacle
         dont elle etait a 1 cm dans la realite.
         CE FICHIER NE SERT QU'A L'AFFICHAGE. Il n'entre ni dans la cinematique
         (firmware) ni dans les collisions (footprint de nav2_params.yaml).
         Le corriger ici ne change donc RIEN au comportement du robot, seulement
         a ce que montre RViz. -->
    <origin xyz="0 0.22035 0" rpy="0 0 0"/>
  </joint>
  <link name="hub_left">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.042" length="0.048"/></geometry>
      <material name="noir"/>
    </visual>
  </link>
  <joint name="wheel_left_hub" type="fixed">
    <parent link="wheel_left"/><child link="hub_left"/><origin xyz="0 0 0"/>
  </joint>

  <link name="wheel_right">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.075" length="0.045"/></geometry>
      <material name="pneu_blanc"/>
    </visual>
  </link>
  <joint name="base_to_wheel_right" type="fixed">
    <parent link="base_link"/><child link="wheel_right"/>
    <origin xyz="0 -0.22035 0" rpy="0 0 0"/>
  </joint>
  <link name="hub_right">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.042" length="0.048"/></geometry>
      <material name="noir"/>
    </visual>
  </link>
  <joint name="wheel_right_hub" type="fixed">
    <parent link="wheel_right"/><child link="hub_right"/><origin xyz="0 0 0"/>
  </joint>

  <!-- ===== Roulette folle arriere ===== -->
  <!-- ===== Roue DIRECTRICE arriere (servo RC sur GPIO 14) =====
       Remplace la roulette folle depuis le 03/09/2026.
       x = +0.36 : la roue est DEVANT (inversion du 04/09/2026). Magnitude
       A CONFIRMER AU METRE : 0.36 venait de "20 cm derriere le lidar", mais
       l'utilisateur a ensuite indique 20 cm entre le SERVO et la ROUE. Seule
       cote qui compte : essieu moteur -> point de contact de la roue.
       z = -0.043 : le sol est a -0.0753 (rayon des roues motrices), donc une
       roue de rayon 0.032 a son axe a -0.0433. Le rayon 0.032 est celui de
       l'ancienne roulette et n'a PAS ete remesure : s'il change, corriger le
       rayon ET z ensemble, sinon la roue flotte ou s'enfonce dans le sol.
       Joint FIXE : l'angle de braquage n'est pas anime. L'animer demanderait
       de publier un joint_states alimente par le delta commande du firmware.
       Le modele n'a aucun effet sur la navigation, il ne sert qu'a l'affichage. -->
  <link name="steer_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.032" length="0.022"/></geometry>
      <material name="noir"/>
    </visual>
  </link>
  <!-- Pivot de direction : point FIXE ou la roue pivote autour de l'axe
       vertical. Le decoupage en deux joints est ce qui permet a la roue de
       TOURNER dans RViz : la position vient du joint fixe, l'angle du joint
       revolute ci-dessous, anime par nodes/steer_state.py. -->
  <link name="steer_pivot"/>
  <joint name="base_to_steer_pivot" type="fixed">
    <parent link="base_link"/><child link="steer_pivot"/>
    <origin xyz="0.36 0 -0.043" rpy="0 0 0"/>
  </joint>
  <!-- ANGLE DE BRAQUAGE, seul joint MOBILE du modele. Il faut donc que
       /joint_states soit publie, sinon robot_state_publisher laisse la roue a
       zero : c'est exactement pourquoi elle ne tournait pas avant le
       03/09/2026. Le publieur est nodes/steer_state.py, lance par
       nodes/description.launch.py a cote de robot_state_publisher.
       Bornes = STEER_MAX_RAD du firmware (0.7854 rad = 45 deg), via
       config/ackerbot_geometry.env. Si l'angle configure change, regenerer ce
       fichier ET corriger ces bornes ensemble.
       Sens : angle POSITIF = roue vers la gauche du robot (repere ROS, z en
       haut). La roue etant DEVANT l'essieu moteur, le comportement est celui
       d'une voiture ordinaire : pour virer a gauche elle pointe a GAUCHE.
       (Avant l'inversion du 04/09/2026 c'etait l'inverse, et c'etait la source
       de la confusion sur le "servo qui tourne du mauvais cote".) -->
  <joint name="steer_joint" type="revolute">
    <parent link="steer_pivot"/><child link="steer_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.7854" upper="0.7854" effort="1.0" velocity="3.0"/>
  </joint>

  <!-- ===== 4 montants en bois ===== -->
  <link name="post_rr"><visual><geometry><box size="0.04 0.04 0.27"/></geometry><material name="bois"/></visual></link>
  <joint name="j_post_rr" type="fixed"><parent link="base_link"/><child link="post_rr"/>
    <origin xyz="-0.13 -0.12 0.125"/></joint>
  <link name="post_rl"><visual><geometry><box size="0.04 0.04 0.27"/></geometry><material name="bois"/></visual></link>
  <joint name="j_post_rl" type="fixed"><parent link="base_link"/><child link="post_rl"/>
    <origin xyz="-0.13 0.12 0.125"/></joint>
  <link name="post_fr"><visual><geometry><box size="0.04 0.04 0.27"/></geometry><material name="bois"/></visual></link>
  <joint name="j_post_fr" type="fixed"><parent link="base_link"/><child link="post_fr"/>
    <origin xyz="0.1 -0.12 0.125"/></joint>
  <link name="post_fl"><visual><geometry><box size="0.04 0.04 0.27"/></geometry><material name="bois"/></visual></link>
  <joint name="j_post_fl" type="fixed"><parent link="base_link"/><child link="post_fl"/>
    <origin xyz="0.1 0.12 0.125"/></joint>

  <!-- ===== Plateau superieur en alu ===== -->
  <link name="deck">
    <visual>
      <geometry><box size="0.34 0.32 0.005"/></geometry>
      <material name="alu"/>
    </visual>
  </link>
  <joint name="base_to_deck" type="fixed">
    <parent link="base_link"/><child link="deck"/>
    <origin xyz="-0.02 0 0.262"/>
  </joint>

  <!-- ===== LIDAR N10 (corps ; le repere laser_link vient de la TF) ===== -->
  <link name="lidar_body">
    <visual>
      <geometry><cylinder radius="0.038" length="0.048"/></geometry>
      <material name="noir"/>
    </visual>
  </link>
  <joint name="deck_to_lidar" type="fixed">
    <parent link="base_link"/><child link="lidar_body"/>
    <!-- x = -0.16 : le lidar de CE robot est 16 cm en ARRIERE du centre.
         CETTE VALEUR DOIT SUIVRE MOWBOT_LIDAR_X de bin/run_tf.sh, qui publie
         la TF base_link vers laser_link. Elles avaient diverge : le modele
         dessinait le lidar a +0.10 (comme sur l'autre robot) pendant que la TF
         publiait -0.10. La valeur exacte, MESUREE AU METRE entre l'axe des
         roues et le centre du lidar, est 0.16 m. Vingt centimetres d'ecart, de part et d'autre du centre
         du plateau : le corps du lidar apparaissait donc a l'OPPOSE du point
         d'ou sortaient les scans. Ca donne l'impression d'un lidar mal oriente
         alors que les TF sont justes.
         Le modele n'a AUCUN effet sur la navigation, il ne sert qu'a
         l'affichage. Mais un dessin faux fait chercher des pannes inexistantes. -->
    <origin xyz="0.16 0 0.288"/>
  </joint>

  <!-- ===== Batterie bleue sur la base ===== -->
  <link name="battery">
    <visual>
      <geometry><box size="0.21 0.09 0.075"/></geometry>
      <material name="bleu_batt"/>
    </visual>
  </link>
  <joint name="base_to_battery" type="fixed">
    <parent link="base_link"/><child link="battery"/>
    <origin xyz="0.02 -0.05 0.027" rpy="0 0 0.15"/>
  </joint>

  <!-- ===== Electronique (driver + DevKitC) ===== -->
  <link name="electronics">
    <visual>
      <geometry><box size="0.13 0.10 0.035"/></geometry>
      <material name="vert_pcb"/>
    </visual>
  </link>
  <joint name="base_to_electronics" type="fixed">
    <parent link="base_link"/><child link="electronics"/>
    <origin xyz="-0.06 0.09 0.007" rpy="0 0 -0.2"/>
  </joint>

  <!-- ===== Boitier Jetson sur le plateau ===== -->
  <link name="jetson">
    <visual>
      <geometry><box size="0.11 0.09 0.045"/></geometry>
      <material name="noir"/>
    </visual>
  </link>
  <joint name="deck_to_jetson" type="fixed">
    <parent link="base_link"/><child link="jetson"/>
    <origin xyz="0.06 0.06 0.287" rpy="0 0 0.1"/>
  </joint>

  <!-- ===== Marqueur AVANT (rouge) ===== -->
  <link name="front_marker">
    <visual>
      <geometry><box size="0.05 0.02 0.012"/></geometry>
      <material name="rouge"/>
    </visual>
  </link>
  <joint name="base_to_front" type="fixed">
    <parent link="base_link"/><child link="front_marker"/>
    <origin xyz="0.205 0 -0.012"/>
  </joint>

</robot>
