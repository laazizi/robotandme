# Profils de VITESSE par robot, appliques a nav2_params.yaml au demarrage
# (cf. bin/start_nav.sh). Les deux chassis n'ont rien de comparable :
#
#   robot A (P4, 12 V)      : MAX_WHEEL_SPEED 1.0 m/s   -> rapide
#   robot B (DevKitC, 24 V) : MAX_WHEEL_SPEED 0.06 m/s  -> motoreducteurs tres
#                             lents mais a fort couple
#
# Appliquer les valeurs du 24 V au 12 V faisait ramper le robot a 5.5 cm/s,
# soit 18 fois moins que sa capacite -- c'etait la cause de la "navigation
# lente". L'inverse serait bien pire : le 24 V recevrait des consignes qu'il
# ne peut pas suivre, son PID saturerait et l'asservissement decrocherait.
#
# Choix du profil : fichier robot_profile.env sur le SBC (MOWBOT_ROBOT=a|b),
# sinon la variable d'environnement MOWBOT_ROBOT, sinon le profil B par
# securite -- des vitesses trop basses ne cassent rien.

# --- ROBOT A : P4 + moteurs 12 V ------------------------------------------
# 0.30 m/s : valeur DEJA VALIDEE au sol (calib_1m.py roule a 0.30). Le robot
# peut theoriquement aller a 1.0 m/s, mais pour une tondeuse en interieur, plus
# vite laisserait trop peu de temps de reaction au lidar (6 Hz seulement, soit
# 5 cm parcourus entre deux scans a 0.30 m/s).
A_MAX_VEL_X=0.30
A_MIN_VEL_X=-0.30
A_MAX_SPEED_XY=0.30
# 1.0 rad/s : avec l'entraxe calibre 0.4607, cela demande 0.23 m/s par roue,
# soit bien moins que la vitesse lineaire max -- les rotations restent franches.
A_MAX_VEL_THETA=1.0
# MIN_SPEED_XY / MIN_SPEED_THETA : LAISSER A ZERO. Ce n'est PAS le bon endroit
# pour le seuil de friction statique, et l'essai a immobilise le robot.
#
# L'idee etait de faire rejeter par DWB les commandes trop lentes pour etre
# executees : ces moteurs ne demarrent pas sous 0,13 m/s ni 0,4 rad/s, les roues
# bourdonnent sans entrainer le chassis. On a donc essaye 0.13 / 0.5.
#
# POURQUOI CELA NE PEUT PAS MARCHER. DWB n'echantillonne que dans la fenetre
# ATTEIGNABLE depuis la vitesse actuelle, bornee par les accelerations sur une
# periode de controle. Depuis l'ARRET, a 10 Hz :
#     vitesse atteignable  = acc_lim_x     x 0.1 s = 0.8 x 0.1 = 0.08 m/s
#     rotation atteignable = acc_lim_theta x 0.1 s = 2.0 x 0.1 = 0.20 rad/s
# Or la regle de DWB rejette une trajectoire quand vitesse < MIN_SPEED_XY ET
# rotation < MIN_SPEED_THETA. Avec 0.13 et 0.5, TOUTE la fenetre atteignable
# depuis l'arret etait sous les deux seuils : plus aucune trajectoire valide,
# donc le robot ne pouvait PLUS JAMAIS DEMARRER. Constate immediatement : les
# buts envoyes depuis RViz ne partaient plus.
# Baisser les seuils sous 0.08 les rendrait inoffensifs mais inutiles.
#
# LA COMPENSATION DE FRICTION APPARTIENT AU FIRMWARE, pas au test de validite
# d'une trajectoire : c'est au controleur moteur d'appliquer un minimum de PWM,
# ou un terme d'anticipation, quand il recoit une consigne non nulle. Voir
# FF_GAIN dans le firmware ESP32, actuellement a 0, et le constat que les roues
# ne suivent que 83 % de la consigne.
A_MIN_SPEED_XY=0.0
A_MIN_SPEED_THETA=0.0
A_ACC_LIM_X=0.8
A_ACC_LIM_THETA=2.0
A_DECEL_LIM_X=-1.2
A_DECEL_LIM_THETA=-2.5
# 3 s d'anticipation = 90 cm a 0.30 m/s : de quoi amorcer un evitement.
A_SIM_TIME=3.0

# --- ROBOT B : DevKitC + moteurs 24 V -------------------------------------
# Vitesse max MESUREE a pleine puissance : 0.055 m/s. Ne pas monter au-dela.
B_MAX_VEL_X=0.055
B_MIN_VEL_X=-0.055
B_MAX_SPEED_XY=0.055
B_MAX_VEL_THETA=0.22
# ROBOT B : meme raison, et de surcroit ses vitesses maximales sont bien plus
# basses (0.055 m/s, 0.22 rad/s), donc n'importe quel seuil non nul
# l'immobiliserait plus vite encore.
B_MIN_SPEED_XY=0.0
B_MIN_SPEED_THETA=0.0
B_ACC_LIM_X=0.4
B_ACC_LIM_THETA=1.5
B_DECEL_LIM_X=-0.6
B_DECEL_LIM_THETA=-1.5
B_SIM_TIME=4.0
