# GENERE par bin/gen_ackerbot_geometry.py DEPUIS controllers/ackerbot_p4/main/robot.h
# NE PAS EDITER A LA MAIN : relancer le script. `--check` detecte un fichier perime.
# Source : STEER_X_M=+0.360 m  STEER_MAX_RAD=0.7854 rad (45.0 deg)  TRACK_WIDTH_M=0.4607 m
# Vitesse de croisiere ACKERBOT_MAX_VEL_X=0.30 m/s (config/speeds.env)

# R = |x_s| / tan(delta_max) : rayon de braquage MINIMAL, a fournir a nav2
ACKERBOT_MIN_TURNING_RADIUS=0.360
# k = voie*tan(delta_max)/(2|x_s|) : a la butee, roue int a 36 %, roue ext a 164 %
ACKERBOT_K_MAX=0.640
# angle ou la roue interieure s'arreterait (au-dela elle recule) : 57.4 deg
# vitesse d'essieu max en virage serre pour que la roue exterieure reste sous vmax
ACKERBOT_V_VIRAGE_SERRE=0.183
# w_max = vmax / R_min : rotation max coherente avec le rayon a la vitesse de croisiere
ACKERBOT_MAX_VEL_THETA=0.83
# position signee de la roue directrice (negatif = DERRIERE l'essieu moteur)
ACKERBOT_STEER_X=+0.360
# butee de braquage [rad] : borne du joint revolute de mowbot.urdf et
# ecretage de nodes/steer_state.py, qui anime la roue dans RViz
ACKERBOT_STEER_MAX_RAD=0.7854
