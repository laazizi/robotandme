# Profil transport ETHERNET (UDP) — EMAC interne du P4 + PHY IP101 de la
# carte ESP32-P4-Function-EV-Board. Les GPIO par defaut du composant
# micro-ROS correspondent deja a cette carte (MDC 31, MDIO 52, RST 51).
CONFIG_MICRO_ROS_ESP_NETIF_ENET=y
CONFIG_MICRO_ROS_USE_INTERNAL_ETHERNET=y
CONFIG_MICRO_ROS_ETH_PHY_IP101=y
CONFIG_MICRO_ROS_ETH_MDC_GPIO=31
CONFIG_MICRO_ROS_ETH_MDIO_GPIO=52
CONFIG_MICRO_ROS_ETH_PHY_RST_GPIO=51
CONFIG_MICRO_ROS_ETH_PHY_ADDR=1

# Adresse du micro-ros-agent (le SBC) — A ADAPTER a ton reseau
CONFIG_MICRO_ROS_AGENT_IP="192.168.1.100"
CONFIG_MICRO_ROS_AGENT_PORT="8888"
