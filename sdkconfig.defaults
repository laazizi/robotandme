# Reglages COMMUNS aux deux cartes supportees :
#   esp32p4 -> Waveshare ESP32-P4-ETH        (extras : sdkconfig.defaults.esp32p4)
#   esp32   -> ESP32-WROOM-32U DevKitC V4    (rien de special)
# La cible est choisie par les scripts : build.sh (P4) / build_esp32.sh (WROOM).
# IDF ajoute automatiquement sdkconfig.defaults.<target> si le fichier existe.

# Tick FreeRTOS a 1 kHz pour un timing de boucle de controle precis
CONFIG_FREERTOS_HZ=1000

# Le transport micro-ROS est choisi par profil :
#   sdkconfig.serial (defaut) ou sdkconfig.eth (P4 uniquement) — voir scripts/
